# Rebar_DSL
## แผ่นพื้น เหล็กเหล็กตรง สองชั้น

## ส่วนตัวแปร
length = 1200.mm   # x
width = 4000.mm    # y
thk = 100.mm       # z
cvr = 20.mm

diaX = 9.mm
sx = 150.mm
diaY = 6.mm
sy = 200.mm
#endHook = [true,true]
endHook = [false,false]

ext_L = 150.mm
ext_R = 150.mm
ext_T = 150.mm
ext_B = 150.mm

colorX = 'maroon'
colorY = 'blue'

## ส่วนเริ่มสร้าง
set_host  new_group("Slab")
conc1 = box 'concrete' , [length, width , thk]
conc1.material = set_material('concrete', 'Bisque', 0.3)
translate conc1, [length/2, width/2,-thk/2]

dz_x = -thk + cvr + diaX/2
dz_y = -thk + cvr + diaX + diaY/2
if width<length then
  tmp = dz_x
  dz_x = dz_y
  dz_y = tmp
end

## เหล็กทิศ X เหล็กนอน
rebarX = rebar 'RebarX' , diaX , '00' , 
   {'A'=>length + ext_L + ext_R ,  'end_hook'=>endHook}, colorX
nx = (width/sx).to_i
gap = (width-sx*nx)/2
if gap<1.mm
  nx -= 1
  gap = (width-sx*nx)/2
end
translate rebarX, [-ext_L, gap , dz_x]
rebarX = make_component 'RebarX' 
copy rebarX, nx , [0,sx,0]
### เหล็กชั้นบน
rebarX_Top = copy rebarX, 1 , [0,0,0]
translate rebarX_Top , [0,0,-2*dz_x - thk]
copy rebarX_Top, nx , [0,sx,0]

## เหล็กทิศ y เหล็กตั้ง
rebarY = rebar 'RebarY' , diaY , '00' , 
   {'A'=>width + ext_T + ext_B ,  'end_hook'=>endHook}, colorY
rotate rebarY, [0,0,0] , [0,0,1] , 90.degrees
ny = (length/sy).to_i
gap = (length-sy*ny)/2
if gap<1.mm
  ny -= 1
  gap = (length-sy*ny)/2
end
translate rebarY, [gap ,-ext_B,  dz_y]
rebarY = make_component 'RebarY' 
copy rebarY, ny , [sy,0,0]
### เหล็กชั้นบน
rebarY_Top = copy rebarY, 1 , [0,0,0]
translate rebarY_Top , [0,0,-2*dz_y - thk]
copy rebarY_Top, ny , [sy,0,0]
## Done