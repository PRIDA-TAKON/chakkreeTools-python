def draw_all_beam(beamList)
  	mainGrp = new_group('Beams_Familt01')
		set_host mainGrp
    i = 1
    x = 0; y = 0
    beamList.each{|name, data|
       grp = mainGrp.entities.add_group
       grp.name = name
       set_host  grp
       beam_section [x ,y], name , data['size'], data['rebars']
       grp.transform! Geom::Transformation.translation([x,y,0])
       x += 1.m
       if i%3==0 then	
          x= 0;  y -= 1.m
       end
       i+=1
    }
    set_host mainGrp
  	mainGrp.transform!  Geom::Transformation.rotation([0,0,0], X_AXIS, 90.degrees)
end

draw_all_beam beamList
