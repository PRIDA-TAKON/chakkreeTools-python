# RebarScript บันไดตรงท้องเรียบแบบธรรมดาก่อน ต้นแบบ

var W = 1000.mm  # ความกว้างบันได
var R = 190.mm   # ระยะลูกตั้ง
var T = 250.mm   # ระยะลูกนอน
var t = 150.mm   # ความหนาบันได
var n = 10       # จำนวนขั้น

