# เสา สี่เหลี่่ยม เหล็กยืน 8 เส้น 

CheckCreator "chakkree_tools",  "หน้าตัดเสาสี่เหลี่ยมแบบ0"
get_attribute "chakkree_tools", "data", 'JSON' 

inputbox 'ป้อนค่าสร้างเสา 3D', \
   ["ความสูงเสา = " , "ระยะยื่นเหล็กเสริมด้านบน = " ,  \
                 "ระยะยื่นเหล็กเสริมด้านล่าง = "], \
   [1000.mm , -50.mm  , 200.mm  ] , \
   ["","" ,""] , \
   ['h', 'ext_top' , 'ext_bttm']

set b = '$b'.to_l
set t = '$t'.to_l
set dia1 = '$dia1'.to_l
set diaStir  = '$diaStir'.to_l
var s = '$spacing'.to_l
var cvr = '$covering'.to_l


# concrete
Box 'concrete' , [$b,$t,$h] ,['concrete','Bisque',0.3]
Translate 'concrete' , [0,0,$h/2]
Make_Component 'concrete'      # มาใหม่ v0.2.15+

var a1 = 300.mm - $dia1/2
var b1 = 0
var z1 = -$ext_bttm + $dia1/2
var dx = $b/2 - $cvr - $diaStir - $dia1/2
var dy = $t/2 - $cvr - $diaStir - $dia1/2
# เหล็กยืน มุม ๆ
rebar 'Main1', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
rot 'Main1' , [0,0,0] , [0,0,1] , 45
tran 'Main1',[-$dx , -$dy , 0]
Make_Component 'Main1'      # มาใหม่ v0.2.15+

copy 'Main1' , 1 , [0, 0, 0]
rot 'LastCopy' , [-$dx , -$dy ,0], [0,0,1], 90
tran 'LastCopy',[2*$dx , 0 , 0]
copy 'Main1' , 1 , [0, 0, 0]
rot 'LastCopy' , [-$dx , -$dy,0], [0,0,1], 180
tran 'LastCopy',[2*$dx , 2*$dy  , 0]
copy 'Main1' , 1 , [0, 0, 0]
rot 'LastCopy' , [-$dx , -$dy ,0], [0,0,1], -90
tran 'LastCopy',[0 , 2*$dy  , 0]


# เหล็กยืน กลาง ๆ
var s1 = ($dx*2) / 2

if  $n1==6 or $n1==8
   copy 'Main1' , 1 , [0, 0, 0]
   rot 'LastCopy' , [-$dx , -$dy ,0], [0,0,1] , 45
   tran 'LastCopy',[$dx , 0  , 0]

   copy 'Main1' , 1 , [0, 0, 0]
   rot 'LastCopy' , [-$dx , -$dy ,0], [0,0,1] , -135
   tran 'LastCopy',[$dx , 2*$dy  , 0]
endif

#set  dx = $b/2 - $cvr - $diaStir - $dia1/2
if  $n1==8
   copy 'Main1' , 1 , [0, 0, 0]
   rot 'LastCopy' , [-$dx , -$dy ,0], [0,0,1] , -45
   tran 'LastCopy',[ 0 , $dy  , 0]

   copy 'Main1' , 1 , [0, 0, 0]
   rot 'LastCopy' , [-$dx , -$dy ,0], [0,0,1] , 135
   tran 'LastCopy',[ 2*$dx , $dy  , 0]
endif


set a1 = $b - 2*$cvr
set b1 = $t - 2*$cvr
var nStir = (($ext_bttm - 50.mm + $h)/ $s).round
set factor_Lh = 4

rebar 'stir1', 6.mm , 51 , [$b1, $a1 , 135] , default # , $nStir , $s
rot 'stir1',[0,0,0],[0,1,0] , -90
tran 'stir1', [0,0, -$ext_bttm + 50.mm] 
Make_Component 'stir1'      # มาใหม่ v0.2.15+
copy 'stir1' , $nStir-1 , [0,0,$s]

set_rotation_same_selected

#set a1 = $s1 + $dia1 + $diaStir * 2
#rebar 'stir2', 6.mm , 51 , [$b1, $a1 , 135] , default , $nStir  , $s
#rot 'stir2',[0,0,0],[0,1,0] , -90.degrees
#tran 'stir2', [0,0, -$ext_bttm + 50.mm + $diaStir*1.3] 
