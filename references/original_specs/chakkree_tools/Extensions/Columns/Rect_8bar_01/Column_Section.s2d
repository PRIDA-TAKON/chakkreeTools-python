# จองก่อน เพื่อใช้เป็นค่า default
var b = 300.mm
var t = 200.mm
var cvr = 25.mm
var dia1 = 12.mm
var diaStir = 6.mm
var s = 150.mm
var n1 = 8

break_IfNOT "หน้าตัดเสาสี่เหลี่ยมเหล็กยืน8แบบ1"

# ตรวจว่าเป็น "หน้าตัดเสาสี่เหลี่ยมเหล็กยืน8แบบ1"
get_attribute "chakkree_tools", "script_creater", 'STRING'  


# เป็น trick ในการลักไก่
if "$script_creater"=="หน้าตัดเสาสี่เหลี่ยมเหล็กยืน8แบบ1"
   get_attribute "chakkree_tools", "data", "JSON"
end

set b = '$b'.to_l
set t = '$t'.to_l
set dia1 = '$dia1'.to_l
set diaStir = '$diaStir'.to_l

# bug ที่เกิดเมื่อชื่อไม่ตรง จะคืน 0 ไป ระวัง
if "$script_creater"=="หน้าตัดเสาสี่เหลี่ยมเหล็กยืน8แบบ1"
   set cvr = '$covering'.to_l
   set s = '$spacing'.to_l
end

inputbox 'ป้อนค่าวาดหน้าตัดเสาสี่เหลี่ยม เหล็กยืน 8 เส้น', \
   ['b = ' , 't = ' , 'ระยะหุ้ม=' ,'dia.เหล็กยืน = ' , \
     'dia.เหล็กปลอก = ' , 'ระยะห่างเหล็กปลอก = ' ] , \
   [$b , $t , $cvr ,  \
     "%dmm"%($dia1).to_mm.round , \
     "%dmm"%($diaStir).to_mm.round, $s] , \
   ['','', '','12mm|16mm|20mm|25mm|28mm|32mm' , '6mm|9mm' , ''] , \
   ['b' , 't', 'cvr' , 'dia1' , 'diaStir' , 's']

if "$script_creater"=="หน้าตัดเสาสี่เหลี่ยมเหล็กยืน8แบบ1"
    GET_SELECTION
    CLEAR_ENTITIES
end

#dumpvar x
#dumpvar cvr
#dumpvar dia1

set dia1 = '$dia1'.to_l            # ลักไก่ myEval มีปัญหากับ string
set diaStir = '$diaStir'.to_l      # ลักไก่ myEval มีปัญหากับ string
set n1 = 8
var fSize = 35.mm

rect -$b/2 , -$t/2 , $b ,$t

dim -$b/2 , $t/2 + 50.mm , $b , 100.mm , $b.to_s , $fSize, 0.degrees
dim -$b/2 - 50.mm , -$t/2 , $t , 100.mm , $t.to_s , $fSize, 90.degrees

var x1 = $b/2 - $cvr 
var y1 = $t/2 - $cvr 
var s1 = (2*$x1)/3
dumpvar cvr
RoundRect  -$x1, -$y1, 2*$x1 , 2*$y1 , 2*$diaStir 
RoundRect  -$x1+$s1-$dia1/2, -$y1, 2*$x1-2*$s1+$dia1*2 , 2*$y1 , 2*$diaStir 

set x1 = $x1  - $dia1/2
set y1 = $y1  - $dia1/2

# เหล็กยืน 4 มุม
circle   $x1 - $dia1/2 ,$y1 -$dia1/2 , $dia1/2 , 'black' , 12
circle - $x1+ $dia1/2 ,$y1 -$dia1/2, $dia1/2 , 'black' , 12
circle   $x1 - $dia1/2 , -$y1 +$dia1/2 , $dia1/2 , 'black' , 12
circle - $x1+ $dia1/2 , - $y1 +$dia1/2, $dia1/2 , 'black' , 12


circle   -$x1 + $s1 ,$y1 - $dia1 / 2   , $dia1 / 2 , 'black' , 12
circle   -$x1 + 2*$s1 ,$y1 - $dia1 / 2   , $dia1 / 2 , 'black' , 12
circle   -$x1 + $s1 ,-$y1 + $dia1/2   , $dia1 / 2 , 'black' , 12
circle   -$x1 + 2*$s1 ,-$y1 + $dia1/2   , $dia1 / 2 , 'black' , 12

text $b/2 + 50.mm ,   $fSize*1.2 ,  \
  "8-DB" + $dia1.to_mm.round.to_s + "มม"  , $fSize
text $b/2 + 50.mm , - $fSize ,  \
  "2ป-RB" + $diaStir.to_mm.round.to_s + "มม @" +   $s.to_mm.round.to_s + "มม" , $fSize


# ติดตั้งข้อมูลไปกับโมเดล ตามหลักการ BIM Process
set_attribute "chakkree_tools", "type", 'STRING' , "Column_2DTOP"
set_attribute "chakkree_tools", "script_creater", 'STRING' , "หน้าตัดเสาสี่เหลี่ยมเหล็กยืน8แบบ1"
set_attribute "chakkree_tools", "rebar_script", 'STRING' , "Rect_8bar_01/Rect_8bar_01.crs"
set_attribute "chakkree_tools", "data", 'JSON' , \
   '{"b":"%dmm"%($b.to_mm.round), \
     "t":"%dmm"%($t.to_mm.round), \
     "covering":"%dmm"%($cvr.to_mm.round), \
     "n1": $n1 , "dia1":"%dmm"%($dia1.to_mm.round) , \
     "spacing": "%dmm"%($s.to_mm.round), "diaStir":"%dmm"%($diaStir.to_mm.round)  }'
