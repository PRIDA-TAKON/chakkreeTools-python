# เสา สี่เหลี่่ยม เหล็กยืน 14 เส้น 
var b = 300.mm
var t = 600.mm
var dia1 = 16.mm

var diaStir = 6.mm
var spacing = 250.mm
var covering = 30.mm

#CheckCreator "chakkree_tools", "หน้าตัดเสาสี่เหลี่ยมเหล็กยืน16แบบ1"
#get_attribute "chakkree_tools", "data", 'JSON' 

inputbox 'ป้อนค่าสร้างเสา 3D', \
   ["ความสูงเสา = " , "ระยะยื่นเหล็กเสริมด้านบน = " ,  \
                 "ระยะยื่นเหล็กเสริมด้านล่าง = "], \
   [1500.mm , 300.mm  , 250.mm  ] , \
   ["","" ,""] , \
   ['h', 'ext_top' , 'ext_bttm']

set b = '$b'.to_l
set t =  '$t'.to_l
set dia1 = '$dia1'.to_l
set diaStir  = '$diaStir'.to_l
var s = '$spacing'.to_l
var cvr = '$covering'.to_l


# concrete
Box 'concrete' , [$b,$t,$h] ,['concrete','Bisque',0.3]
Translate 'concrete' , [0,0,$h/2]

var a1 = 300.mm - $dia1/2
var b1 = 0
var z1 = -$ext_bttm + $dia1/2
var dx = $b/2 - $cvr - $diaStir - $dia1/2
var dy = $t/2 - $cvr - $diaStir - $dia1/2
# เหล็กยืน มุม ๆ
rebar 'M1', $dia1 , 99 , \
  [(0,-$a1,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M1',[-$dx , -$dy , 0]
rebar 'M2', $dia1 , 99 , \
  [(0,-$a1,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M2',[$dx , -$dy , 0]
rebar 'M3', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M3',[-$dx , $dy , 0]
rebar 'M4', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
rot 'M4' , [0,0,0] , [0,0,1] , 180.degrees
tran 'M4',[$dx , $dy , 0]

# เหล็กยืน กลาง ๆ
var s1 = ($dx*2) / 2

rebar 'M5', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
rot 'M5' , [0,0,0] , [0,0,1] , 90.degrees
tran 'M5',[0 , -$dy , 0]

rebar 'M6', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
rot 'M6' , [0,0,0] , [0,0,1] , -90.degrees
tran 'M6',[0 , $dy , 0]

# เหล็กยืน แถว2 คอลัมภ์ 2
var s2 = ($dy*2) / 4
rebar 'M7', $dia1 , 99 , \
  [(0,$a1,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
rot 'M7' , [0,0,0] , [0,0,1] , -70.degrees
tran 'M7',[0 , $s2 , 0]
rebar 'M8', $dia1 , 99 , \
  [(0,-$a1,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
rot 'M8' , [0,0,0] , [0,0,1] , -70.degrees
tran 'M8',[0 , -$s2 , 0]

rebar 'M11', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M11',[ -$dx ,$s2 , 0]
rebar 'M12', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M12',[ -$dx ,0 , 0]
rebar 'M13', $dia1 , 99 , \
  [(-$a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M13',[ -$dx ,-$s2 , 0]

rebar 'M14', $dia1 , 99 , \
  [($a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M14',[ $dx ,$s2 , 0]
rebar 'M15', $dia1 , 99 , \
  [($a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M15',[ $dx ,0 , 0]
rebar 'M16', $dia1 , 99 , \
  [($a1,0,$z1),(0,0,$z1), (0,0,+$h+$ext_top) ], default
tran 'M16',[ $dx ,-$s2 , 0]

set a1 =  $s1 + $dia1 + 2.8*$diaStir
set b1 = $t - 2*$cvr
var nStir = (($ext_bttm - 50.mm + $h)/$s).round
set factor_Lh = 4

rebar 'stir1', 6.mm , 51 , [$b1, $a1 , 135] , default , $nStir , $s
rot 'stir1',[0,0,0],[0,1,0] , -90.degrees
tran 'stir1', [-$a1/2+$dia1/2+$diaStir*1.4,0, -$ext_bttm + 100.mm] 

rebar 'stir2', 6.mm , 51 , [$b1, $a1 , 135] , blue , $nStir  , $s
rot 'stir2',[0,0,0],[0,1,0] , -90.degrees
rot 'stir2',[0,0,0],[0,0,1] , 180.degrees
tran 'stir2', [$a1/2-$dia1/2-$diaStir*1.4,0, -$ext_bttm + 100.mm + $diaStir*1.3] 

var a2 = $b - 2*$cvr
var b2 = 3*$s2 + $dia1 + 2.8*$diaStir
rebar 'stir3', 6.mm , 51 , [$b2, $a2 , 135] , red , $nStir  , -$s
rot 'stir3',[0,0,0],[0,1,0] , 90.degrees
tran 'stir3', [0,0.5*$s2, -$ext_bttm + 100.mm - $diaStir*1.8] 

rebar 'stir4', 6.mm , 51 , [$b2, $a2 , 135] , gold , $nStir  , -$s
rot 'stir4',[0,0,0],[0,1,0] , 90.degrees
rot 'stir4',[0,0,0],[0,0,1] , 180.degrees
tran 'stir4', [0,-0.5*$s2, -$ext_bttm + 100.mm - $diaStir*2.8] 

set_rotation_same_selected
