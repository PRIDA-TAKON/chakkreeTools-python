# เหล็กเสริมฐานรากเสาเข็ม 2 ต้น

name PileCAP_2P

CheckCreator "chakkree_tools",'ฐานรากเสาเข็ม2ต้น'
get_attribute "chakkree_tools", "data", 'JSON' 
#dumpvar x

set B = '$B'.to_l
set L = '$L'.to_l
set t = '$t'.to_l

set Dp = '$Dp'.to_l




# concrete
Box 'concrte' , [$L,$B,$t] ,['concrete','Bisque',0.3]
Translate 'concrte' , [0,0,-$t/2]
Make_Component 'concrte'        # มาใหม่ v0.2.15+

var cvr = '$covering'.to_l
#set n1 = 5
set dia1 = '$dia1'.to_l
#set n2 = 5
set dia2 = '$dia2'.to_l
#var nStir = 
set diaStir = '$diaStir'.to_l


var factorLh  = 6.0
var factorDb  = 4.0
var r = ($factorDb / 2 + 0.5) * $dia1
var gap = $cvr + $r + $dia2
var s = ($B - 2*$gap)/($n1-1)

var a = (($factorDb / 2 + 0.5) + $factorLh )  * $dia1
var b = $t - 2* $cvr - $dia2
var c = $L - 2* $cvr

rebar 'Main1', $dia1 , 41 , [$a ,$b , $c , $b ,$a] , default #, S , $n1 , $s
tran 'Main1' , [-$c/2 , -($B-2*$gap)/2 , - $t + $cvr + $dia2]
Make_Component 'Main1'        # มาใหม่ v0.2.15+
copy 'Main1',  $n1 - 1 , [0, $s , 0] 

set gap = $cvr + $r + $dia1
set s = ($L - 2*$gap)/($n2-1)
set a = (($factorDb / 2 + 0.5) + $factorLh  )  * $dia2
set b = $t - 2* $cvr - $dia1
set c = $B - 2* $cvr
rebar 'Main2', $dia2 , 41 , [$a ,$b , $c , $b ,$a] , default #, S , $n2 , $s
rot 'Main2' , [0,0,0], [0,0,1], 90
tran 'Main2' , [ -($L-2*$gap)/2 , -$c/2 , -$t + $cvr ]
Make_Component 'Main2'        # มาใหม่ v0.2.15+
copy 'Main2',  $n2 - 1 , [$s, 0 , 0] 

# เหล็กปลอก
set a = $B - 2* $cvr - 2 * $dia1
set b = $L - 2* $cvr - 2 * $dia1
rebar 'stir', $diaStir  , 51 , [$a, $b , 90] , default
rot 'stir', [0,0,0] , [0,1,0] , 90
tran 'stir', [0, 0 , -$cvr - $dia1 - $dia2 - 20.mm ]
Make_Component 'stir'        # มาใหม่ v0.2.15+

#  เสาเข็ม v0.2.15+
var lenPile = 6.m
Pile 'Rect_Pile1' , RECT , $Dp  , $lenPile , ['concrete_pile','Gainsboro',1]
tran 'Rect_Pile1' , [-$factor_CC*$Dp/2,0, -$t+50.mm]
Make_Component 'Rect_Pile1'        # มาใหม่ v0.2.15+
copy 'Rect_Pile1', 1 , [$factor_CC*$Dp,0, 0] 

#Pile 'Rect_Pile2' , RECT , $Dp  , $lenPile , ['concrete_pile','Gainsboro',1]
#tran 'Rect_Pile2' , [$factor_CC*$Dp/2,0, -$t+50.mm]

set_rotation_same_selected
